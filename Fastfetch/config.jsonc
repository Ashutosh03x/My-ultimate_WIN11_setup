{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "file",
    "source": "C:/Users/%USERPROFILE/.config/fastfetch/ascii.txt",
    "color": {
      "1": "#cba6f7",
      "2": "#89b4fa",
      "3": "#94E2D5",
      "4": "#FAB387",
      "5": "#F9E2AF",
      "6": "#A6E3A1",
      "7": "#F5C2E7",
      "8": "#89DCEB",
      "9": "#b06fc7"
    },
    "padding": {
      "top": 1,
      "right": 3
    }
  },
  "display": {
    "separator": " "
  },
  "modules": [
    "break",
    {
      "type": "title",
      "color": {
        "user": "#f4b8e4",
        "at": "#BAC2DE",
        "host": "#89DCEB"
      }
    },
    "break",
    {
      "type": "os",
      "key": "󰣇",
      "keyColor": "#89DCEB",
      "format": "Windows 11 (25H2) x86_64"
    },
    {
      "type": "cpu",
      "key": "󰻠",
      "keyColor": "#F5C2E7"
    },
    {
      "type": "memory",
      "key": "",
      "keyColor": "#A6E3A1",
      "format": "{used} / {total}"
    },
    {
      "type": "disk",
      "key": "",
      "keyColor": "#94E2D5"
    },
    "break",
    {
      "type": "separator",
      "string":"─────────────────"
    },
    {
      "type": "colors",
      "symbol": "diamond"
    }
  ]
}
